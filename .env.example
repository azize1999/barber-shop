# DATABASE CONFIGURATION
# Required for Prisma ORM to connect to the database
DATABASE_URL="file:./prisma/dev.db"

# ADMIN AUTHENTICATION
# Secret password for admin endpoints (PATCH, DELETE /api/reservations)
# Must be kept secure and set as a strong password in Vercel
ADMIN_PASSWORD="your-secret-admin-password"

# EMAIL NOTIFICATIONS (Resend)
# API key for sending emails via Resend
# Get it from: https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxx"

# Email sender address (must be verified in Resend)
# If not set, defaults to "onboarding@resend.dev"
EMAIL_FROM="noreply@yourbarber.shop"

# SMS NOTIFICATIONS (Twilio)
# Twilio account credentials for sending SMS
# Get them from: https://www.twilio.com
TWILIO_ACCOUNT_SID="AC_xxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="+33123456789"

# SHOP CONFIGURATION
# Shop name used in SMS and email notifications
SHOP_NAME="Your Barbershop"

# ENVIRONMENT
# Set to 'production' on Vercel, 'development' locally
NODE_ENV="development"
